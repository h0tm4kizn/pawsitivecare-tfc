# ──────────────────────────────────────────────────────────────────────────────
# PawsitiveCare — Species-Adaptive Pet Identification Module
# Environment Variables
#
# Copy this file to .env and fill in your values.
# Both Python API servers (dog :8000, cat :8001) load this file automatically.
# ──────────────────────────────────────────────────────────────────────────────

# ── Supabase (production) ─────────────────────────────────────────────────────
# Leave blank to fall back to SQLite (local dev mode).
# Use the service_role key so the servers can bypass RLS and read/write freely.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-service-role-key-here

# ── CORS allowed origins ──────────────────────────────────────────────────────
# Comma-separated. localhost:5173 and 127.0.0.1:5173 are always included.
# Example: ALLOWED_ORIGINS=https://pawsitivecare.com,https://app.pawsitivecare.com
ALLOWED_ORIGINS=
BIOMETRIC_ALLOWED_ORIGINS=
BIOMETRIC_MAX_UPLOAD_BYTES=5242880
BIOMETRIC_MAX_IMAGE_PIXELS=25000000

# ── ROI Detection (YOLOv8) ───────────────────────────────────────────────────
# Optional YOLO ROI weight overrides.
# Leave these blank to use the repository-relative default models:
#   roi-annotation/work/runs/dog_nose/weights/best.pt
#   roi-annotation/work/runs/cat_face/weights/best.pt
ROI_DOG_WEIGHTS=
ROI_CAT_WEIGHTS=

# ROI confidence is currently fixed by the runtime at 0.25 in
# shared/biometric_config.py; there is no environment override.

# Production is the default. Set to 0 only for explicit non-production use;
# non-production behavior may permit full-frame fallback. Production requires
# a valid YOLO ROI and rejects invalid or missing ROI detection.
BIOMETRIC_PRODUCTION=1
