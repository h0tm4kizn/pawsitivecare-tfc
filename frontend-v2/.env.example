# Frontend should call same-origin proxy paths.
# This avoids mixed-content/CORS issues when frontend is served over HTTPS.
VITE_API_URL=/api
VITE_API_TARGET=http://127.0.0.1:8000

# Pet recognition engines (proxied by Vite)
VITE_PET_ID_DOG_URL=/dog-api
VITE_PET_ID_CAT_URL=/cat-api

# Optional: actual upstream targets for Vite proxy
VITE_PET_ID_DOG_TARGET=http://127.0.0.1:8010
VITE_PET_ID_CAT_TARGET=http://127.0.0.1:8011
VITE_PET_ID_CAMERA_FACING_MODE=environment
VITE_PET_ID_CAMERA_MIRRORED=true
