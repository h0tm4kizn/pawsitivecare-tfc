# PowerSync Configuration
VITE_POWERSYNC_URL=https://<powersync-instance>.powersync.journeyapps.com
VITE_API_URL=http://127.0.0.1:8002

# Supabase Configuration
SUPABASE_URL=https://<supabase-project-ref>.supabase.co
SUPABASE_ANON_KEY=<supabase-anon-key>

# PowerSync Admin - Database Connection
PS_DATABASE_URI=postgresql://<user>:<password>@<host>:<port>/postgres

# PowerSync Admin Token (optional for local dev)
PS_ADMIN_TOKEN=<powersync-admin-token>
