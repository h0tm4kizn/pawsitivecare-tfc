    APP_NAME=Laravel
    APP_ENV=local
    APP_KEY=
    # PowerSync secrets are supplied only through the deployment environment.
    POWERSYNC_URL=https://<powersync-instance>.powersync.journeyapps.com
    POWERSYNC_DATABASE_URI=
    POWERSYNC_EC_PRIVATE_KEY_PATH=
    POWERSYNC_EC_KEY_ID=pawsitivecare-ec-1
    PS_ADMIN_TOKEN=
    SEED_CUSTOMERS=
    # Local development may enable this intentionally. Production must set
    # APP_ENV=production and APP_DEBUG=false in the deployment environment.
    APP_DEBUG=true
    APP_TIMEZONE=Asia/Manila
    APP_URL=http://127.0.0.1:8000

    APP_LOCALE=en
    APP_FALLBACK_LOCALE=en
    APP_FAKER_LOCALE=en_US

    APP_MAINTENANCE_DRIVER=file
    APP_MAINTENANCE_STORE=database

    BCRYPT_ROUNDS=12

    LOG_CHANNEL=stack
    LOG_STACK=single
    LOG_DEPRECATIONS_CHANNEL=null
    LOG_LEVEL=debug

    # ─── Database ──────────────────────────────────────────────────────────────────
    # ONLINE  (default): connects to Supabase PostgreSQL
    # # DB_URL="postgresql://<username>:<password>@<host>:<port>/postgres"
    # DB_CONNECTION=pgsql
    # DB_HOST=<supabase-host>
    # DB_PORT=5432
    # DB_DATABASE=postgres
    # DB_USERNAME=postgres
    # DB_PASSWORD=<supabase-database-password>
    # DB_SSLMODE=require
    # DB_SCHEMA=public
    # DB_PREPARED_STATEMENTS=false

    # OFFLINE / DEMO: uses the local SQLite snapshot committed to the repo.
    # 1. While online, whoever has internet runs:  php artisan db:export-sqlite
    # 2. Commit the updated database/database.sqlite and push.
    # 3. Team pulls → everyone gets the same data.
    # 4. Switch to offline mode by changing DB_CONNECTION below to sqlite:
    DB_CONNECTION=sqlite
    # ───────────────────────────────────────────────────────────────────────────────

    SESSION_DRIVER=database
    SESSION_LIFETIME=120
    SESSION_ENCRYPT=false
    SESSION_PATH=/
    SESSION_DOMAIN=null

    BROADCAST_CONNECTION=log
    FILESYSTEM_DISK=public
    QUEUE_CONNECTION=database

    CACHE_STORE=database
    CACHE_PREFIX=

    MEMCACHED_HOST=127.0.0.1

    REDIS_CLIENT=phpredis
    REDIS_HOST=127.0.0.1
    REDIS_PASSWORD=null
    REDIS_PORT=6379

    # Mail (Gmail SMTP)
    # MAIL_PASSWORD must be a Gmail App Password, not your regular Gmail password.
    # Generate one at: Google Account → Security → 2-Step Verification → App Passwords
    MAIL_MAILER=smtp
    MAIL_HOST=smtp.gmail.com
    MAIL_PORT=587
    MAIL_USERNAME=your-gmail@gmail.com
    MAIL_PASSWORD=your-gmail-app-password
    MAIL_ENCRYPTION=tls
    MAIL_FROM_ADDRESS=your-gmail@gmail.com
    MAIL_FROM_NAME="The Fur Club"

    # Set to true only after production mail is configured.
    LOGIN_OTP_ENABLED=false

    # Supabase Storage (leave blank to use local public disk)
    SUPABASE_ACCESS_KEY_ID=
    SUPABASE_SECRET_ACCESS_KEY=
    SUPABASE_REGION=ap-southeast-1
    SUPABASE_BUCKET=pawsitivecare
    SUPABASE_URL=

    AWS_ACCESS_KEY_ID=
    AWS_SECRET_ACCESS_KEY=
    AWS_DEFAULT_REGION=us-east-1
    AWS_BUCKET=
    AWS_USE_PATH_STYLE_ENDPOINT=false

    VITE_APP_NAME="${APP_NAME}"
